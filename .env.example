# Runtime-only secrets (set in Coolify). Never prefix with NEXT_PUBLIC_.
ADMIN_USERNAME=
# Generate with: node scripts/hash-password.mjs
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Use the regular Content API (https://api-<region>.hygraph.com/v2/<project>/master), NOT the
# High Performance CDN endpoint (*.cdn.hygraph.com): the CDN caches reads, so the admin panel
# would show stale data right after publish/unpublish/activate.
HYGRAPH_CONTENT_API_URL=
HYGRAPH_ADMIN_TOKEN=
INVITE_SECRET=

# Dev only. Your computer's LAN IP (comma-separated for several) so a phone can open the dev server.
DEV_ALLOWED_ORIGINS=
